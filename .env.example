# Copy to .env.local and fill in to run online (shared lobbies across phones).
# Both values are from Supabase: Project Settings -> API Keys. The publishable
# (anon) key is safe to ship in the app. NEVER put the secret/service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx
